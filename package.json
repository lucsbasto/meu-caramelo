{
  "name": "meu-caramelo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "main": "expo-router/entry",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks",
    "new-task": "node scripts/new-task.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:new": "npx supabase migration new",
    "db:list": "npx supabase migration list --linked",
    "db:push": "npx supabase db push --linked",
    "db:repair": "npx supabase migration repair --status applied --linked",
    "db:types": "npx supabase gen types typescript --linked > src/lib/database.types.ts"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rnmapbox/maps": "10.3.5",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^57.0.23",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
