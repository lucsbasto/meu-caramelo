{
  "version": 8,
  "name": "Meu Caramelo — Caramelo Quente",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sprite": "mapbox://sprites/mapbox/streets-v12",
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "layers": [
    {
      "id": "fundo",
      "type": "background",
      "paint": { "background-color": "#EFEAE0" }
    },
    {
      "id": "area-verde",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["park", "grass", "pitch", "cemetery", "scrub", "wood"],
        true,
        false
      ],
      "paint": { "fill-color": "#CFE2BE", "fill-opacity": 0.9 }
    },
    {
      "id": "area-construida",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["hospital", "school", "commercial_area"],
        true,
        false
      ],
      "paint": { "fill-color": "#E8E1D2" }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#AFD2E5" }
    },
    {
      "id": "curso-dagua",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#AFD2E5",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 18, 6]
      }
    },
    {
      "id": "predios",
      "type": "fill",
      "source": "composite",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#E2DACA",
        "fill-outline-color": "#D8CFBC",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15.5, 1]
      }
    },

    {
      "id": "via-local-contorno",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service", "track"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E6E0D0",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          13,
          2,
          18,
          18
        ]
      }
    },
    {
      "id": "via-local",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service", "track"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FEFCF7",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          13,
          1,
          18,
          13
        ]
      }
    },

    {
      "id": "via-secundaria-contorno",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["secondary", "tertiary"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#DED7C7",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          10,
          2,
          18,
          24
        ]
      }
    },
    {
      "id": "via-secundaria",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["secondary", "tertiary"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FEFCF7",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          10,
          1,
          18,
          18
        ]
      }
    },

    {
      "id": "via-principal-contorno",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["primary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#D8CDB6",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          8,
          2,
          18,
          30
        ]
      }
    },
    {
      "id": "via-principal",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["primary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          8,
          1,
          18,
          23
        ]
      }
    },

    {
      "id": "rodovia-contorno",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "motorway_link", "trunk_link"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E0A93A",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          6,
          2,
          18,
          32
        ]
      }
    },
    {
      "id": "rodovia",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "motorway_link", "trunk_link"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#F8CD68",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          6,
          1,
          18,
          25
        ]
      }
    },

    {
      "id": "caminho",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 15,
      "filter": [
        "match",
        ["get", "class"],
        ["path", "pedestrian", "footway"],
        true,
        false
      ],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#D6CDB9",
        "line-width": 2,
        "line-dasharray": [2, 2]
      }
    },

    {
      "id": "rotulo-via",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "street"],
        true,
        false
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_pt"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 18, 13],
        "text-letter-spacing": 0.02,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#7E7464",
        "text-halo-color": "#FCF6EE",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "rotulo-bairro",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": [
        "match",
        ["get", "type"],
        ["neighbourhood", "suburb", "quarter"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_pt"], ["get", "name"]],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 11, 16, 15],
        "text-letter-spacing": 0.08,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#8A7460",
        "text-halo-color": "#FCF6EE",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "rotulo-cidade",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": [
        "match",
        ["get", "type"],
        ["city", "town", "village"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_pt"], ["get", "name"]],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 13, 14, 20]
      },
      "paint": {
        "text-color": "#5C3A21",
        "text-halo-color": "#FCF6EE",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "rotulo-poi",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "minzoom": 15,
      "filter": [
        "match",
        ["get", "class"],
        ["park_like", "food_and_drink", "medical", "education"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_pt"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 11,
        "text-offset": [0, 0.8],
        "text-anchor": "top",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8A7460",
        "text-halo-color": "#FCF6EE",
        "text-halo-width": 1.4
      }
    }
  ]
}
