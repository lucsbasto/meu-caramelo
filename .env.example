# Copie para .env e preencha. NUNCA commite o .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google OAuth (WP3) — Web client id do Google Cloud (usado no signInWithIdToken)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS/Android client ids do Google (config nativa do @react-native-google-signin)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Edge Function enviar-push (WP14, §7.5) — NÃO são vars do app ---
# Defina como secrets da função:
#   supabase secrets set PUSH_TZ=America/Araguaina EXPO_ACCESS_TOKEN=...
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados pela plataforma.
# PUSH_TZ: fuso para o silêncio noturno/teto diário (default America/Araguaina).
# EXPO_ACCESS_TOKEN: opcional; exigido se o projeto Expo ativar push security.
